<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮窗根容器：展开态（面板）与折叠态（贴边半圆）互斥显示 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ================= 展开态：状态面板 ================= -->
    <LinearLayout
        android:id="@+id/panelExpanded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/dotFloat"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/dot" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFloatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="准备中…"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFloatSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnFloatStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/btn_danger"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="停止"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFloatCollapse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_ghost"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:text="收起"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ================= 折叠态：贴边半圆 ================= -->
    <FrameLayout
        android:id="@+id/bubbleCollapsed"
        android:layout_width="22dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_bubble_at_left"
        android:visibility="gone">

        <View
            android:id="@+id/dotBubble"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_gravity="center"
            android:background="@drawable/dot" />
    </FrameLayout>
</FrameLayout>
