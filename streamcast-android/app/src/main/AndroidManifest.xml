<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络：与中继服务通信 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 悬浮窗权限：显示直播状态控制条 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 前台服务（屏幕采集必须运行在前台服务中） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 设备音频内录（AudioPlaybackCapture 抓取系统播放声音，非麦克风） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 我们并不采集麦克风，只是 AudioRecord 内录需要该权限；
         显式声明为非必需，避免无麦克风设备被应用商店过滤 -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StreamCast">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".UserCenterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReceiverActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/receiver_title" />

        <service
            android:name=".StreamService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
            远程控制（实验性功能）的 AccessibilityService。
            由系统绑定，必须 exported="true"，并用 BIND_ACCESSIBILITY_SERVICE 权限保护，
            保证只有系统能连接；应用自身不会、也无法主动启动它。
        -->
        <service
            android:name=".RemoteControlService"
            android:exported="true"
            android:label="@string/remote_control_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_control_service" />
        </service>
    </application>

</manifest>
